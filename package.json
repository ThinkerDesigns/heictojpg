{
  "name": "switchback",
  "version": "1.0.0",
  "description": "A calm, batch-friendly HEIC and JPEG converter for macOS and Windows.",
  "main": "main.js",
  "author": "Switchback",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis --x64",
    "dist": "electron-builder --mac dmg --win nsis --x64"
  },
  "build": {
    "appId": "com.switchback.converter",
    "productName": "Switchback",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "archiver": "^7.0.1",
    "heic-convert": "^2.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "sharp@0.33.5": true
  }
}
